# Required. Create a bot with @BotFather and never commit the real token.
TELEGRAM_BOT_TOKEN=

# Leave empty for the first launch. /start returns your numeric user ID.
# Multiple IDs are comma-separated.
TELEGRAM_ALLOWED_USER_IDS=

# Directory where Codex will work. An empty value means the current directory.
CODEX_CWD=

# Optional Codex overrides. Empty values use the active Codex CLI configuration.
CODEX_BIN=codex
CODEX_MODEL=
CODEX_REASONING_EFFORT=

# auto works on most networks. Use ipv4 or ipv6 only when the network requires it.
TELEGRAM_IP_FAMILY=auto
POLL_TIMEOUT_SECONDS=30

# Optional local voice transcription. Install the package with the voice extra.
VOICE_TRANSCRIPTION_ENABLED=false
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru
VOICE_MAX_DURATION_SECONDS=600
VOICE_MAX_FILE_BYTES=20971520

# Optional narrow auto-approval for App Server reads and allowlisted Arc reads.
# Paths are comma-separated. An empty value limits reads to CODEX_CWD.
AUTO_APPROVE_SAFE_READ_ONLY=false
AUTO_APPROVE_READ_ROOTS=

# Optional. Empty means the platform-specific application data directory.
BOT_STATE_PATH=

# Desktop launcher mode. remote deploys and controls the bot over SSH.
RUN_MODE=local

# Remote Linux host settings (OpenSSH + user systemd are required).
REMOTE_SSH_HOST=
REMOTE_SSH_USER=
REMOTE_SSH_PORT=22
REMOTE_SSH_IDENTITY_FILE=
REMOTE_INSTALL_DIR=~/.local/share/scooters-codex-telegram-bot
REMOTE_CODEX_CWD=~/arcadia
REMOTE_CODEX_BIN=codex
REMOTE_PYTHON_BIN=/usr/bin/python3
